  integer, parameter :: ATTR_NAME_LEN  = 64
  integer, parameter :: ATTR_VALUE_LEN = 256

  type :: t_hdf5_attr
    character(len=ATTR_NAME_LEN)  :: name  = ""
    character(len=ATTR_VALUE_LEN) :: value = ""
